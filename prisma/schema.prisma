// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique @db.VarChar(48)
  email        String   @unique @db.VarChar(255)
  name         String?
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  spaces      Space[]
  // abone olunan spaces
  subscriptions Subscription[] @relation("UserSubscriptions")
  // home post
  homePost HomePost? @relation("UserHomePosts")
  @@map("users")
}

model Session {
  sessionId        String   @id @db.Uuid @map("session_id") // Matches the JWT `jti`
  userId    String   @db.Uuid @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}
model Space {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @db.VarChar(64)
  ownerId    String   @db.Uuid @map("owner_id")
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Normal post listesi ilişkisi
  posts      Post[]   @relation("SpacePosts")

  // Öne çıkan / ana sayfa postu (1-1 ilişki)
  homePostId String?  @unique @db.Uuid @map("home_post_id")
  homePost   Post?    @relation("homePost", fields: [homePostId], references: [id], onDelete: SetNull)

  // abone olanlar
  subscriptions Subscription[] @relation("SpaceSubscriptions")

  // also creates an index on slug and ownerId for efficient lookups
  @@unique([slug, ownerId])
  @@index([ownerId, createdAt])

  @@map("spaces")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")


  // Ait olduğu space
  spaceId   String   @db.Uuid @map("space_id")
  space     Space    @relation("SpacePosts", fields: [spaceId], references: [id], onDelete: Cascade)

  // Eğer bu post bir space'in homePost'u ise ters ilişki:
  homeSpace Space?   @relation("homePost")
  // allows finding posts by spaceId efficiently
  @@index([spaceId, createdAt])

  @@map("posts")
}

model Subscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  spaceId   String   @db.Uuid @map("space_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, spaceId])
  user      User    @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  space     Space   @relation("SpaceSubscriptions", fields: [spaceId], references: [id], onDelete: Cascade)
  @@map("subscriptions")
}

model HomePost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String  @unique  @db.Uuid @map("user_id")

  content   String

  createdAt  DateTime @default(now()) @map("created_at")

  user      User    @relation("UserHomePosts", fields: [userId], references: [id], onDelete: Cascade)
  @@map("home_posts")
}
